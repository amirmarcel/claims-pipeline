__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
*.egg-info/
dist/
build/

# local env / secrets
.env
.env.local

# LocalStack / docker volumes
infra/local/.localstack/
infra/local/volumes/

# editor
.vscode/
.idea/
.DS_Store

# Terraform (infra/eks/) -- local plan/init artifacts and state, never
# committed. .terraform.lock.hcl IS committed (Terraform's own convention).
infra/eks/.terraform/
infra/eks/*.tfstate
infra/eks/*.tfstate.*
infra/eks/*.tfplan

# Pulumi (infra/pulumi/) -- local file-backend state and per-stack config,
# never committed (infra/pulumi/README.md "Local backend").
infra/pulumi/.pulumi-state/
infra/pulumi/Pulumi.*.yaml

# benchmark run artifacts (reports themselves are committed deliberately per-run; raw logs are not)
benchmark/reports/*.log
