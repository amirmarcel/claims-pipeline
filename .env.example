# Copy to .env and fill in real values. .env is gitignored; never commit real keys.

# Anthropic API key — required for the live-model guardrail tests in
# tests/ (the deterministic/stubbed guardrail assertions run without it).
# Get one at https://console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Local rig Postgres (matches infra/local/docker-compose.yml — host port 5433).
CLAIMS_PIPELINE_DATABASE_URL=postgresql://claims:claims@127.0.0.1:5433/claims_pipeline

# LocalStack endpoint for the SNS/SQS integration + reliability tests.
LOCALSTACK_ENDPOINT_URL=http://localhost:4566
